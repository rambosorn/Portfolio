<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Lumora — Independent Design & Engineering Studio</title>
  <meta name="description" content="Lumora is an independent studio crafting brands, products, and the systems that connect them — bold ideas, shipped with quiet precision." />
  <meta name="theme-color" content="#0a0a0a" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    /* ==========================================================================
       CSS Reset & Design System Variables
       ========================================================================== */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --background: #ffffff;
      --foreground: #111111;
      --ink: #0a0a0a;
      --muted: #8d8d8d;
      --subtle: #b6b6b6;
      --line: #e6e5e2;
      --surface: #f1f0ee;
      --surface-2: #e3e2df;
      --accent: #b15f2c;
      --accent-from: #cf8047;
      --accent-to: #97501f;
      --hero-from: #ecebe9;
      --hero-to: #c9c9c9;
      --radius-pill: 9999px;
      --radius-card: 2rem;
      --radius-card-sm: 1.25rem;
      --radius-control: 0.875rem;
      --text-watermark: 13rem;
      --container-shell: 88rem;
    }

    html {
      font-size: 16px;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    body {
      background: var(--background);
      color: var(--foreground);
      font-family: 'Onest', sans-serif;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font: inherit;
      color: inherit;
      background: none;
      border: none;
      cursor: pointer;
    }

    ul {
      list-style: none;
    }

    img {
      display: block;
      max-width: 100%;
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    :focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    /* Rem-based adaptive grid (scaled proportionally to viewport) */
    @media (max-width: 1920px) { html { font-size: 0.833333vw; } }
    @media (max-width: 1440px) { html { font-size: 1.111111vw; } }
    @media (max-width: 1024px) { html { font-size: 1.5625vw; } }
    @media (max-width: 640px)  { html { font-size: 4.444444vw; } }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation: none !important;
        transition: none !important;
      }
    }

    /* Shell container */
    .shell {
      max-width: var(--container-shell);
      margin-inline: auto;
      width: 100%;
    }

    /* Skip link */
    .skip-link {
      position: fixed;
      left: 1rem;
      top: 1rem;
      z-index: 130;
      border-radius: var(--radius-control);
      background: var(--ink);
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
      color: #fff;
      transform: translateY(-150%);
      transition: transform 0.2s ease;
    }
    .skip-link:focus {
      transform: translateY(0);
    }

    /* ==========================================================================
       Reusable Component Classes
       ========================================================================== */
    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.875rem;
      font-weight: 500;
    }
    .eyebrow.tone-dark {
      color: rgba(17, 17, 17, 0.7);
    }
    .eyebrow.tone-dark .eyebrow-dot {
      background: rgba(17, 17, 17, 0.5);
    }
    .eyebrow.tone-light {
      color: rgba(255, 255, 255, 0.7);
    }
    .eyebrow.tone-light .eyebrow-dot {
      background: rgba(255, 255, 255, 0.6);
    }
    .eyebrow-dot {
      width: 0.375rem;
      height: 0.375rem;
      border-radius: 9999px;
      flex-shrink: 0;
    }

    /* Pill Button */
    .pill-btn {
      display: inline-block;
      vertical-align: middle;
      cursor: pointer;
    }
    .pill-btn-inner {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      border-radius: var(--radius-pill);
      font-size: 0.875rem;
      font-weight: 500;
      transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
      white-space: nowrap;
    }
    .pill-btn.no-arrow .pill-btn-inner {
      padding: 0.875rem 1.75rem;
    }
    .pill-btn.has-arrow .pill-btn-inner {
      padding: 0.375rem 0.375rem 0.375rem 1.5rem;
    }
    /* Variants */
    .pill-btn.variant-dark .pill-btn-inner {
      background: var(--ink);
      color: #fff;
    }
    .pill-btn.variant-light .pill-btn-inner {
      background: var(--surface);
      color: var(--foreground);
    }
    .pill-btn.variant-outline .pill-btn-inner {
      border: 1px solid var(--line);
      background: transparent;
      color: var(--foreground);
    }

    /* Button Badge */
    .pill-btn-badge {
      width: 2.25rem;
      height: 2.25rem;
      display: grid;
      place-items: center;
      border-radius: 9999px;
      font-size: 1rem;
      flex-shrink: 0;
    }
    .pill-btn.variant-dark .pill-btn-badge {
      background: #fff;
      color: var(--ink);
    }
    .pill-btn.variant-light .pill-btn-badge,
    .pill-btn.variant-outline .pill-btn-badge {
      background: var(--ink);
      color: #fff;
    }
    .pill-btn-badge svg {
      transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    @media (hover: hover) and (pointer: fine) {
      .pill-btn:hover .pill-btn-inner {
        transform: scale(1.04);
      }
      .pill-btn:hover .pill-btn-badge svg.arrow-right-icon {
        transform: translate(3px, 0);
      }
      .pill-btn:hover .pill-btn-badge svg.arrow-up-right-icon {
        transform: translate(2px, -2px);
      }
    }

    /* Tag Chip */
    .tag-chip {
      display: inline-flex;
      border: 1px solid rgba(255, 255, 255, 0.25);
      color: #fff;
      border-radius: var(--radius-pill);
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
      font-weight: 400;
    }

    /* Animated Link */
    .animated-link {
      display: inline-flex;
      align-items: center;
      cursor: pointer;
    }
    .animated-link-inner {
      display: inline-block;
      transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
      opacity: 0.65;
    }
    @media (hover: hover) and (pointer: fine) {
      .animated-link:hover .animated-link-inner {
        transform: translateX(4px);
        opacity: 1;
      }
      .animated-link.legal-link:hover .animated-link-inner {
        transform: translateX(3px);
        opacity: 1;
      }
    }
    .animated-link.legal-link .animated-link-inner {
      opacity: 0.7;
    }

    /* ==========================================================================
       Reveals & Motions
       ========================================================================== */
    .reveal-line-wrap {
      display: block;
      overflow: hidden;
      line-height: inherit;
    }
    .reveal-line-inner {
      display: block;
      transform: translateY(100%);
      opacity: 0;
      transition: transform 900ms cubic-bezier(0.215, 0.61, 0.355, 1), opacity 900ms cubic-bezier(0.215, 0.61, 0.355, 1);
    }
    .is-revealed .reveal-line-inner,
    .reveal-line-inner.revealed {
      transform: translateY(0);
      opacity: 1;
    }

    .word-reveal-word {
      display: inline-block;
      transform: translateY(24px);
      opacity: 0;
      transition: transform 700ms cubic-bezier(0.165, 0.84, 0.44, 1), opacity 700ms cubic-bezier(0.165, 0.84, 0.44, 1);
      margin-right: 0.28em;
    }
    .is-revealed .word-reveal-word,
    .word-reveal-word.revealed {
      transform: translateY(0);
      opacity: 1;
    }

    .spring-reveal {
      opacity: 0;
      transform: translateY(var(--reveal-y, 20px)) scale(var(--reveal-scale-from, 1));
      transition: opacity var(--reveal-dur, 800ms) cubic-bezier(0.16, 1, 0.3, 1),
                  transform var(--reveal-dur, 800ms) cubic-bezier(0.16, 1, 0.3, 1);
    }
    .spring-reveal.is-revealed {
      opacity: 1;
      transform: translateY(0) scale(1);
    }

    /* ==========================================================================
       Page Loader (000 -> 100)
       ========================================================================== */
    #page-loader {
      position: fixed;
      inset: 0;
      z-index: 120;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2rem;
      background: var(--ink);
      color: #fff;
      border-radius: 0 0 var(--radius-card) var(--radius-card);
      will-change: transform;
    }
    .loader-center {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1.25rem;
      opacity: 1;
      will-change: opacity, transform;
    }
    .loader-brand {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-weight: 600;
      font-size: 1.5rem;
      letter-spacing: -0.01em;
    }
    @media (min-width: 640px) {
      .loader-brand { font-size: 1.875rem; }
    }
    .loader-brand svg {
      font-size: 1.875rem;
      color: var(--accent-from);
    }
    .loader-subtext {
      max-width: 24ch;
      font-size: 0.875rem;
      color: rgba(255, 255, 255, 0.55);
      line-height: 1.4;
    }
    .loader-progress-wrap {
      width: min(22rem, 72vw);
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .loader-track {
      height: 1px;
      width: 100%;
      background: rgba(255, 255, 255, 0.15);
      position: relative;
      overflow: hidden;
    }
    .loader-fill {
      height: 100%;
      background: var(--accent-from);
      width: 0%;
      transition: width 0.1s ease-out;
    }
    .loader-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.75rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: rgba(255, 255, 255, 0.45);
    }
    .loader-counter {
      color: rgba(255, 255, 255, 0.8);
      font-variant-numeric: tabular-nums;
    }

    /* ==========================================================================
       Header
       ========================================================================== */
    #site-header {
      position: absolute;
      inset-inline: 0;
      top: 0;
      z-index: 50;
      opacity: 0;
      transform: translateY(-14px);
      transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }
    #site-header.is-revealed {
      opacity: 1;
      transform: translateY(0);
    }
    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      padding: 1.25rem;
    }
    @media (min-width: 640px) {
      .header-inner {
        padding: 2rem 2rem;
      }
    }
    .header-logo-btn {
      display: inline-flex;
      align-items: center;
    }
    .header-logo-span {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 1.125rem;
      font-weight: 600;
      letter-spacing: -0.01em;
      transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .header-logo-span svg {
      font-size: 1.25rem;
      color: var(--accent);
    }
    @media (hover: hover) and (pointer: fine) {
      .header-logo-btn:hover .header-logo-span {
        transform: scale(1.04);
      }
    }

    .primary-nav {
      display: none;
    }
    @media (min-width: 1024px) {
      .primary-nav {
        display: flex;
      }
    }
    .primary-nav-list {
      display: flex;
      align-items: center;
      gap: 2rem;
      font-size: 0.875rem;
      font-weight: 500;
    }
    .nav-btn {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
    }
    .nav-btn-label {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      opacity: 0.8;
      transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .nav-caret {
      font-size: 0.75rem;
      opacity: 0.6;
    }
    @media (hover: hover) and (pointer: fine) {
      .nav-btn:hover .nav-btn-label {
        transform: translateY(-2px);
        opacity: 1;
      }
    }
    .nav-btn[aria-current="page"] .nav-btn-label {
      opacity: 1;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .clock-chip {
      display: none;
      align-items: center;
      gap: 0.75rem;
      border: 1px solid rgba(230, 229, 226, 0.8);
      background: rgba(255, 255, 255, 0.4);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      border-radius: var(--radius-control);
      padding: 0.5rem 0.75rem;
      font-size: 0.75rem;
      color: rgba(17, 17, 17, 0.7);
    }
    @media (min-width: 768px) {
      .clock-chip {
        display: flex;
      }
    }
    .clock-label {
      color: rgba(17, 17, 17, 0.45);
    }
    .clock-time {
      min-width: 3.5rem;
      font-variant-numeric: tabular-nums;
      font-weight: 500;
      color: #111;
    }
    .clock-sep {
      color: rgba(17, 17, 17, 0.3);
    }
    .clock-date {
      font-weight: 500;
    }

    .menu-btn {
      border: 1px solid rgba(230, 229, 226, 0.8);
      background: rgba(255, 255, 255, 0.4);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      border-radius: var(--radius-control);
      transition: background 0.2s ease;
    }
    @media (hover: hover) and (pointer: fine) {
      .menu-btn:hover {
        background: rgba(255, 255, 255, 0.7);
      }
    }
    .menu-btn-inner {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1rem;
      font-size: 0.75rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .menu-btn-inner svg {
      font-size: 0.875rem;
    }
    .menu-text {
      display: none;
    }
    @media (min-width: 640px) {
      .menu-text {
        display: inline;
      }
    }
    @media (hover: hover) and (pointer: fine) {
      .menu-btn:hover .menu-btn-inner {
        transform: scale(1.05);
      }
    }

    /* ==========================================================================
       Hero Section (#home)
       ========================================================================== */
    #home {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      border-radius: 0 0 var(--radius-card) var(--radius-card);
      background: var(--hero-to);
      min-height: 100lvh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .liquid-reveal-wrap {
      position: absolute;
      inset: 0;
      z-index: 0;
    }
    .liquid-base-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .liquid-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }

    .hero-vignette {
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      background: linear-gradient(to bottom, rgba(255, 255, 255, 0.35), transparent, rgba(255, 255, 255, 0.35));
    }

    .hero-watermark {
      pointer-events: none;
      position: absolute;
      inset-inline: 0;
      bottom: 7rem;
      z-index: 1;
      text-align: center;
      user-select: none;
      font-weight: 700;
      line-height: 1;
      font-size: var(--text-watermark);
      color: rgba(255, 255, 255, 0.4);
      letter-spacing: -0.02em;
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .hero-watermark.is-revealed {
      opacity: 0.4;
      transform: translateY(0);
    }

    .hero-content {
      position: relative;
      z-index: 20;
      display: flex;
      flex-direction: column;
      gap: 2rem;
      padding: 7rem 1.25rem 3rem;
      flex: 1;
    }
    @media (min-width: 640px) {
      .hero-content {
        padding-inline: 2rem;
      }
    }
    @media (min-width: 1024px) {
      .hero-content {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 2.5rem;
        padding: 9rem 2rem 4rem;
        align-content: center;
      }
    }

    .hero-left {
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
      justify-content: center;
    }
    @media (min-width: 1024px) {
      .hero-left {
        grid-column: span 7;
      }
    }

    .hero-h1 {
      max-width: 18ch;
      font-size: 2.25rem;
      font-weight: 600;
      line-height: 0.98;
      letter-spacing: -0.02em;
    }
    @media (min-width: 640px) {
      .hero-h1 { font-size: 3rem; }
    }
    @media (min-width: 768px) {
      .hero-h1 { font-size: 3.75rem; }
    }

    .hero-rating-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .stars-wrap {
      display: inline-flex;
      align-items: center;
      gap: 0.125rem;
      color: var(--accent);
      font-size: 1rem;
    }
    .rating-text {
      font-size: 0.875rem;
      font-weight: 500;
      color: rgba(17, 17, 17, 0.7);
    }

    .hero-cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .hero-right {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 2rem;
      justify-content: center;
    }
    @media (min-width: 1024px) {
      .hero-right {
        grid-column: span 5;
        align-items: flex-end;
      }
    }

    /* Hero Carousel Card */
    .hero-card {
      width: 100%;
      max-width: 24rem;
      border-radius: var(--radius-card-sm);
      background: rgba(255, 255, 255, 0.7);
      padding: 0.5rem;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
      border: 1px solid rgba(230, 229, 226, 0.7);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      cursor: pointer;
    }
    @media (min-width: 1024px) {
      .hero-card {
        width: 19rem;
      }
    }
    .hero-card-inner {
      display: flex;
      gap: 0.5rem;
      border-radius: var(--radius-control);
    }
    .hero-card-tile {
      aspect-ratio: 1;
      width: 6rem;
      display: grid;
      place-items: center;
      border-radius: var(--radius-control);
      background: var(--ink);
      font-size: 1.875rem;
      color: #fff;
      flex-shrink: 0;
    }
    .hero-card-tile svg {
      color: var(--accent-from);
    }
    .hero-card-panel {
      flex: 1;
      border-radius: var(--radius-control);
      background: rgba(241, 240, 238, 0.7);
      padding: 0.75rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      overflow: hidden;
    }
    .hero-card-slot {
      position: relative;
      min-height: 3.25rem;
      overflow: hidden;
    }
    .hero-card-slide {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .hero-card-slide.slide-active {
      transform: translateY(0);
      opacity: 1;
      position: relative;
    }
    .hero-card-slide.slide-out-prev {
      transform: translateY(14px);
      opacity: 0;
      position: absolute;
    }
    .hero-card-slide.slide-out-next {
      transform: translateY(-14px);
      opacity: 0;
      position: absolute;
    }
    .hero-card-slide.slide-in-next {
      transform: translateY(14px);
      opacity: 0;
      position: absolute;
    }
    .hero-card-slide.slide-in-prev {
      transform: translateY(-14px);
      opacity: 0;
      position: absolute;
    }
    .hero-card-caption {
      font-size: 0.65rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: rgba(17, 17, 17, 0.45);
    }
    .hero-card-title {
      max-width: 8rem;
      font-size: 0.875rem;
      font-weight: 500;
      line-height: 1.35;
      color: #111;
    }
    .hero-card-controls {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 0.5rem;
    }
    .hero-card-dots {
      display: flex;
      align-items: center;
      gap: 0.25rem;
    }
    .hero-card-dot {
      height: 0.25rem;
      border-radius: 9999px;
      transition: all 0.3s ease;
    }
    .hero-card-dot.active {
      width: 1rem;
      background: rgba(17, 17, 17, 0.7);
    }
    .hero-card-dot.inactive {
      width: 0.375rem;
      background: rgba(17, 17, 17, 0.2);
    }
    .hero-card-nav-btns {
      display: flex;
      align-items: center;
      gap: 0.25rem;
    }
    .hero-card-nav-btn {
      width: 1.75rem;
      height: 1.75rem;
      display: grid;
      place-items: center;
      border-radius: 9999px;
      background: #fff;
      color: rgba(17, 17, 17, 0.7);
      box-shadow: 0 0 0 1px var(--line);
      font-size: 0.75rem;
      transition: color 0.2s ease;
    }
    @media (hover: hover) and (pointer: fine) {
      .hero-card-nav-btn:hover {
        color: #111;
      }
    }
    .hero-card-nav-btn.prev svg {
      transform: rotate(180deg);
    }

    /* Partners */
    .hero-partners {
      width: 100%;
      max-width: 24rem;
    }
    @media (min-width: 1024px) {
      .hero-partners {
        width: 19rem;
      }
    }
    .partners-label {
      margin-bottom: 0.75rem;
      font-size: 0.75rem;
      font-weight: 500;
      color: rgba(17, 17, 17, 0.45);
      text-align: left;
    }
    @media (min-width: 1024px) {
      .partners-label {
        text-align: right;
      }
    }
    .partners-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      column-gap: 1rem;
      row-gap: 0.75rem;
    }
    .partner-item {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      font-size: 0.75rem;
      color: rgba(17, 17, 17, 0.7);
      transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .partner-item svg {
      font-size: 0.875rem;
      color: rgba(17, 17, 17, 0.4);
    }
    @media (hover: hover) and (pointer: fine) {
      .partner-item:hover {
        transform: translateY(-2px);
        opacity: 1;
      }
    }

    /* Status Bar */
    .hero-status-bar {
      border-top: 1px solid rgba(17, 17, 17, 0.1);
      padding: 1.25rem;
      font-size: 0.75rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.025em;
      color: rgba(17, 17, 17, 0.6);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      position: relative;
      z-index: 20;
    }
    @media (min-width: 640px) {
      .hero-status-bar {
        padding-inline: 2rem;
      }
    }
    .status-mid {
      display: none;
    }
    @media (min-width: 640px) {
      .status-mid {
        display: inline;
      }
    }
    .status-right {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      cursor: pointer;
    }

    /* ==========================================================================
       About Section (#about)
       ========================================================================== */
    #about {
      background: #fff;
    }
    .about-shell {
      display: grid;
      grid-template-columns: 1fr;
      align-items: center;
      gap: 3rem;
      padding: 5rem 1.25rem;
    }
    @media (min-width: 640px) {
      .about-shell {
        padding-inline: 2rem;
      }
    }
    @media (min-width: 1024px) {
      .about-shell {
        grid-template-columns: 1fr 1fr;
        padding-block: 7rem;
      }
    }

    .about-globe-block {
      position: relative;
      min-height: 14rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    @media (min-width: 1024px) {
      .about-globe-block {
        min-height: 20rem;
      }
    }
    .about-globe-bg {
      position: absolute;
      left: -1rem;
      top: 50%;
      transform: translateY(-50%);
      font-size: 12rem;
      color: rgba(17, 17, 17, 0.1);
      pointer-events: none;
      z-index: 0;
    }
    @media (min-width: 640px) {
      .about-globe-bg { font-size: 16rem; }
    }
    @media (min-width: 1024px) {
      .about-globe-bg {
        left: -1.5rem;
        font-size: 20rem;
      }
    }
    .about-eyebrow-wrap {
      position: relative;
      z-index: 1;
    }
    .about-globe-sub {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 0.875rem;
      color: rgba(17, 17, 17, 0.7);
    }
    .about-globe-sub svg {
      font-size: 1.5rem;
      color: #111;
      flex-shrink: 0;
    }
    .about-globe-sub span {
      max-width: 14rem;
    }

    .about-statement {
      display: flex;
      flex-direction: column;
      gap: 2.5rem;
    }
    .about-h2 {
      font-size: 1.5rem;
      font-weight: 500;
      line-height: 1.35;
      letter-spacing: -0.01em;
    }
    @media (min-width: 640px) {
      .about-h2 { font-size: 1.875rem; }
    }
    .about-h2-dim {
      color: var(--muted);
    }

    .about-footer-row {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      justify-content: space-between;
      gap: 1.5rem;
      border-top: 1px solid var(--line);
      padding-top: 1.5rem;
    }
    .social-block {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .social-label {
      font-size: 0.875rem;
      color: rgba(17, 17, 17, 0.45);
    }
    .social-chips-row {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .social-chip {
      width: 2.25rem;
      height: 2.25rem;
      display: grid;
      place-items: center;
      border-radius: 9999px;
      font-size: 0.875rem;
      cursor: pointer;
    }
    .social-chip svg {
      transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    @media (hover: hover) and (pointer: fine) {
      .social-chip:hover svg {
        transform: scale(1.18);
      }
    }
    .social-chip.chip-accent {
      background: var(--accent);
      color: #fff;
    }
    .social-chip.chip-surface {
      background: var(--surface);
      color: rgba(17, 17, 17, 0.7);
    }

    /* ==========================================================================
       CreateBand ("We Build → Better")
       ========================================================================== */
    .create-band-section {
      background: #fff;
    }
    .create-band-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      padding: 2.5rem 1.25rem;
    }
    @media (min-width: 640px) {
      .create-band-list {
        flex-direction: row;
        gap: 1rem;
        padding-inline: 2rem;
      }
    }
    .create-band-item {
      flex: 1;
    }
    .create-tile {
      display: grid;
      place-items: center;
      height: 6rem;
      border-radius: 9999px;
      font-size: 1.875rem;
      font-weight: 500;
      transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
      cursor: default;
    }
    @media (min-width: 640px) {
      .create-tile {
        height: 10rem;
        font-size: 2.25rem;
      }
    }
    @media (hover: hover) and (pointer: fine) {
      .create-tile:hover {
        transform: scale(1.03);
      }
    }
    .create-tile.tile-light {
      background: var(--surface);
      color: #111;
    }
    .create-tile.tile-accent {
      background: linear-gradient(to bottom right, var(--accent-from), var(--accent-to));
      color: #fff;
    }
    .create-tile.tile-dark {
      background: var(--ink);
      color: #fff;
    }
    .create-tile.tile-dark svg {
      font-size: 2.25rem;
    }
    @media (min-width: 640px) {
      .create-tile.tile-dark svg {
        font-size: 3rem;
      }
    }
    .create-tile.tile-ghost {
      background: rgba(241, 240, 238, 0.6);
      color: rgba(17, 17, 17, 0.35);
    }

    /* ==========================================================================
       Portfolio Section (#works)
       ========================================================================== */
    #works {
      background: #fff;
    }
    .portfolio-shell {
      padding: 2.5rem 1.25rem 5rem;
    }
    @media (min-width: 640px) {
      .portfolio-shell {
        padding-inline: 2rem;
      }
    }
    @media (min-width: 1024px) {
      .portfolio-shell {
        padding-bottom: 7rem;
      }
    }

    .portfolio-header {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      margin-bottom: 3.5rem;
    }
    .portfolio-eyebrow-pill {
      border: 1px solid var(--line);
      border-radius: var(--radius-pill);
      padding: 0.375rem 1rem;
      margin-bottom: 1.25rem;
    }
    .portfolio-h2 {
      font-size: 2.25rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      width: fit-content;
      margin-inline: auto;
    }
    @media (min-width: 640px) {
      .portfolio-h2 { font-size: 3rem; }
    }

    .portfolio-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    @media (min-width: 768px) {
      .portfolio-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .portfolio-card-item {
      display: block;
    }
    .portfolio-card {
      position: relative;
      min-height: 22rem;
      overflow: hidden;
      border-radius: var(--radius-card);
      background: var(--ink);
      padding: 1.5rem;
      color: #fff;
      box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.05);
      display: block;
      transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    @media (min-width: 640px) {
      .portfolio-card {
        min-height: 26rem;
        padding: 2rem;
      }
    }
    @media (hover: hover) and (pointer: fine) {
      .portfolio-card:hover {
        transform: translateY(-8px) scale(1.012);
      }
      .portfolio-card:hover .card-action-badge {
        transform: rotate(45deg) scale(1.08);
      }
    }

    .card-top-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.025em;
      color: rgba(255, 255, 255, 0.45);
      position: relative;
      z-index: 2;
    }
    .card-action-badge {
      width: 2.75rem;
      height: 2.75rem;
      display: grid;
      place-items: center;
      border-radius: 9999px;
      background: rgba(255, 255, 255, 0.1);
      color: #fff;
      box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.15);
      font-size: 1rem;
      transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .card-watermark {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      pointer-events: none;
      z-index: 1;
    }
    .card-watermark-spark {
      display: flex;
      align-items: flex-start;
      color: rgba(255, 255, 255, 0.9);
      font-size: 4.5rem;
    }
    .card-watermark-r {
      font-size: 0.75rem;
      color: rgba(255, 255, 255, 0.6);
      margin-left: 0.15rem;
      margin-top: 0.5rem;
    }

    .card-bottom-block {
      position: absolute;
      inset-inline: 1.5rem;
      bottom: 1.5rem;
      z-index: 2;
    }
    @media (min-width: 640px) {
      .card-bottom-block {
        inset-inline: 2rem;
        bottom: 2rem;
      }
    }
    .card-title {
      font-size: 1.5rem;
      font-weight: 500;
      letter-spacing: -0.01em;
    }
    @media (min-width: 640px) {
      .card-title { font-size: 1.875rem; }
    }
    .card-desc {
      margin-top: 0.5rem;
      max-width: 28rem;
      font-size: 0.875rem;
      color: rgba(255, 255, 255, 0.55);
      line-height: 1.45;
    }
    .card-tags {
      margin-top: 1.25rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    /* ==========================================================================
       Services Section (#services)
       ========================================================================== */
    #services {
      background: #fff;
    }
    .services-shell {
      padding: 5rem 1.25rem;
    }
    @media (min-width: 640px) {
      .services-shell {
        padding-inline: 2rem;
      }
    }
    @media (min-width: 1024px) {
      .services-shell {
        padding-block: 7rem;
      }
    }

    .services-h2 {
      margin: 1.25rem 0 3rem;
      max-width: 16ch;
      font-size: 2.25rem;
      font-weight: 600;
      letter-spacing: -0.02em;
    }
    @media (min-width: 640px) {
      .services-h2 {
        margin-bottom: 3.5rem;
        font-size: 3rem;
      }
    }

    .services-list {
      display: flex;
      flex-direction: column;
    }
    .service-row-item {
      border-top: 1px solid var(--line);
    }
    .service-row-item:first-child {
      border-top: none;
    }
    .service-row-link {
      display: flex;
      align-items: center;
      gap: 1rem;
      border-radius: var(--radius-card-sm);
      padding: 1.5rem 1.5rem;
      background: rgba(241, 240, 238, 0);
      transition: background 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
                  padding-left 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
                  padding-right 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    @media (min-width: 640px) {
      .service-row-link {
        gap: 1.5rem;
        padding-block: 2rem;
      }
    }
    @media (hover: hover) and (pointer: fine) {
      .service-row-link:hover {
        background: rgba(241, 240, 238, 1);
        padding-left: 2rem;
        padding-right: 1.25rem;
      }
      .service-row-link:hover .service-badge svg {
        transform: translateX(5px);
      }
    }

    .service-num {
      width: 1.75rem;
      font-size: 0.875rem;
      font-weight: 500;
      color: rgba(17, 17, 17, 0.4);
      flex-shrink: 0;
    }
    @media (min-width: 640px) {
      .service-num { width: 2.5rem; }
    }
    .service-title {
      flex: 1;
      font-size: 1.5rem;
      font-weight: 500;
      letter-spacing: -0.01em;
    }
    @media (min-width: 640px) {
      .service-title { font-size: 1.875rem; }
    }
    @media (min-width: 768px) {
      .service-title { font-size: 2.25rem; }
    }
    .service-desc {
      display: none;
      max-width: 20rem;
      font-size: 0.875rem;
      color: rgba(17, 17, 17, 0.55);
      line-height: 1.4;
    }
    @media (min-width: 1024px) {
      .service-desc {
        display: block;
      }
    }
    .service-badge {
      width: 2.5rem;
      height: 2.5rem;
      display: grid;
      place-items: center;
      border-radius: 9999px;
      background: var(--ink);
      color: #fff;
      font-size: 1rem;
      flex-shrink: 0;
    }
    @media (min-width: 640px) {
      .service-badge {
        width: 3rem;
        height: 3rem;
      }
    }
    .service-badge svg {
      transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    /* ==========================================================================
       Stats Section (#stats)
       ========================================================================== */
    .stats-section {
      background: #fff;
    }
    .stats-shell {
      padding: 0 1.25rem 5rem;
    }
    @media (min-width: 640px) {
      .stats-shell {
        padding-inline: 2rem;
      }
    }
    @media (min-width: 1024px) {
      .stats-shell {
        padding-bottom: 7rem;
      }
    }

    .stats-panel {
      border-radius: var(--radius-card);
      background: var(--ink);
      padding: 3rem 1.5rem;
      color: #fff;
    }
    @media (min-width: 640px) {
      .stats-panel {
        padding: 4rem 2rem;
      }
    }
    @media (min-width: 768px) {
      .stats-panel {
        padding-inline: 4rem;
      }
    }

    .stats-h2 {
      margin-top: 1rem;
      max-width: 20ch;
      font-size: 1.875rem;
      font-weight: 500;
      letter-spacing: -0.01em;
    }
    @media (min-width: 768px) {
      .stats-h2 { font-size: 2.25rem; }
    }

    .stats-grid {
      margin-top: 3.5rem;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      column-gap: 2rem;
      row-gap: 3rem;
    }
    @media (min-width: 1024px) {
      .stats-grid {
        grid-template-columns: repeat(4, 1fr);
      }
    }

    .stat-number-wrap {
      font-size: 3rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      line-height: 1;
      font-variant-numeric: tabular-nums;
    }
    @media (min-width: 640px) {
      .stat-number-wrap { font-size: 3.75rem; }
    }
    @media (min-width: 768px) {
      .stat-number-wrap { font-size: 4.5rem; }
    }
    .stat-label {
      margin-top: 0.75rem;
      font-size: 0.875rem;
      color: rgba(255, 255, 255, 0.55);
    }

    /* ==========================================================================
       Footer Section
       ========================================================================== */
    #site-footer {
      position: relative;
      overflow: hidden;
      border-radius: var(--radius-card) var(--radius-card) 0 0;
      background: var(--ink);
      color: #fff;
    }
    .footer-shell {
      position: relative;
      z-index: 10;
      padding: 5rem 1.25rem 2.5rem;
    }
    @media (min-width: 640px) {
      .footer-shell {
        padding-inline: 2rem;
      }
    }
    @media (min-width: 1024px) {
      .footer-shell {
        padding-top: 6rem;
      }
    }

    .footer-cta-row {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      padding-bottom: 4rem;
    }
    @media (min-width: 1024px) {
      .footer-cta-row {
        flex-direction: row;
        align-items: flex-end;
        justify-content: space-between;
      }
    }
    .footer-cta-h2 {
      max-width: 16ch;
      font-size: 2.25rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      line-height: 1.05;
    }
    @media (min-width: 640px) {
      .footer-cta-h2 { font-size: 3rem; }
    }
    @media (min-width: 768px) {
      .footer-cta-h2 { font-size: 3.75rem; }
    }

    .footer-cols-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 3rem;
      padding-block: 4rem;
    }
    @media (min-width: 768px) {
      .footer-cols-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (min-width: 1024px) {
      .footer-cols-grid {
        grid-template-columns: repeat(4, 1fr);
      }
    }

    .footer-brand-col {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .footer-brand-title {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 1.125rem;
      font-weight: 600;
      letter-spacing: -0.01em;
    }
    .footer-brand-title svg {
      font-size: 1.25rem;
      color: var(--accent-from);
    }
    .footer-tagline {
      max-width: 20rem;
      font-size: 0.875rem;
      color: rgba(255, 255, 255, 0.55);
      line-height: 1.45;
    }

    .footer-nav-col {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
    .footer-col-title {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.025em;
      color: rgba(255, 255, 255, 0.4);
    }
    .footer-links-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      font-size: 0.875rem;
    }

    .footer-legal-bar {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      padding-top: 2rem;
      font-size: 0.75rem;
      color: rgba(255, 255, 255, 0.45);
    }
    @media (min-width: 640px) {
      .footer-legal-bar {
        flex-direction: row;
      }
    }
    .legal-links {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }

    .footer-watermark {
      position: absolute;
      inset-inline: 0;
      bottom: -1.5rem;
      z-index: 0;
      text-align: center;
      pointer-events: none;
      user-select: none;
      font-weight: 700;
      line-height: 1;
      font-size: var(--text-watermark);
      color: rgba(255, 255, 255, 0.05);
      letter-spacing: -0.02em;
    }

    /* ==========================================================================
       NavMenu Overlay
       ========================================================================== */
    #nav-menu {
      position: fixed;
      inset: 0;
      z-index: 115;
      display: flex;
      flex-direction: column;
      background: var(--ink);
      color: #fff;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }
    #nav-menu.is-open {
      opacity: 1;
      pointer-events: auto;
    }
    .nav-menu-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.25rem;
    }
    @media (min-width: 640px) {
      .nav-menu-top {
        padding: 1.5rem 2rem;
      }
    }
    .nav-menu-brand {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 1.125rem;
      font-weight: 600;
    }
    .nav-menu-brand svg {
      font-size: 1.25rem;
      color: var(--accent-from);
    }
    .nav-menu-close-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: var(--radius-control);
      padding: 0.5rem 1rem;
      font-size: 0.75rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: rgba(255, 255, 255, 0.7);
      transition: border-color 0.2s ease, color 0.2s ease;
    }
    .nav-menu-close-btn svg {
      font-size: 0.875rem;
    }
    @media (hover: hover) and (pointer: fine) {
      .nav-menu-close-btn:hover {
        border-color: rgba(255, 255, 255, 0.4);
        color: #fff;
      }
    }

    .nav-menu-content {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-inline: 1.25rem;
    }
    @media (min-width: 640px) {
      .nav-menu-content {
        padding-inline: 2rem;
      }
    }
    .nav-menu-list {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    .nav-menu-item-btn {
      width: 100%;
      display: flex;
      align-items: baseline;
      gap: 1rem;
      padding-block: 0.5rem;
      text-align: left;
      font-size: 2.25rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      transform: translateY(1rem);
      opacity: 0;
      transition: transform 0.5s ease-out, opacity 0.5s ease-out;
    }
    @media (min-width: 640px) {
      .nav-menu-item-btn {
        font-size: 3.75rem;
      }
    }
    #nav-menu.is-open .nav-menu-item-btn {
      transform: translateY(0);
      opacity: 1;
    }
    .nav-menu-item-index {
      font-size: 1rem;
      font-weight: 400;
      color: rgba(255, 255, 255, 0.3);
      transition: color 0.3s ease;
    }
    .nav-menu-item-label {
      color: rgba(255, 255, 255, 0.7);
      transition: color 0.3s ease;
    }
    @media (hover: hover) and (pointer: fine) {
      .nav-menu-item-btn:hover .nav-menu-item-index {
        color: var(--accent-from);
      }
      .nav-menu-item-btn:hover .nav-menu-item-label {
        color: #fff;
      }
    }

    .nav-menu-bottom {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      padding: 1.5rem 1.25rem;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.025em;
      color: rgba(255, 255, 255, 0.45);
    }
    @media (min-width: 640px) {
      .nav-menu-bottom {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        padding-inline: 2rem;
      }
    }
    .nav-menu-cta-btn {
      color: rgba(255, 255, 255, 0.7);
      transition: color 0.2s ease;
    }
    @media (hover: hover) and (pointer: fine) {
      .nav-menu-cta-btn:hover {
        color: #fff;
        text-decoration: underline;
      }
    }

    /* ==========================================================================
       RequestModal Overlay
       ========================================================================== */
    #request-modal {
      position: fixed;
      inset: 0;
      z-index: 110;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      padding: 1rem;
      background: rgba(17, 17, 17, 0.3);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }
    @media (min-width: 640px) {
      #request-modal {
        align-items: center;
      }
    }
    #request-modal.is-open {
      opacity: 1;
      pointer-events: auto;
    }

    .modal-panel {
      position: relative;
      width: 100%;
      max-width: 32rem;
      overflow: hidden;
      border-radius: var(--radius-card);
      background: #fff;
      padding: 1.5rem;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
      border: 1px solid var(--line);
      transform: translateY(28px);
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }
    @media (min-width: 640px) {
      .modal-panel {
        padding: 2rem;
      }
    }
    #request-modal.is-open .modal-panel {
      transform: translateY(0);
    }

    .modal-close-btn {
      position: absolute;
      right: 1rem;
      top: 1rem;
      width: 2.25rem;
      height: 2.25rem;
      display: grid;
      place-items: center;
      border-radius: 9999px;
      background: var(--surface);
      color: rgba(17, 17, 17, 0.6);
      transition: background 0.2s ease, color 0.2s ease;
    }
    @media (hover: hover) and (pointer: fine) {
      .modal-close-btn:hover {
        background: var(--surface-2);
        color: #111;
      }
    }

    .modal-header-block {
      margin-bottom: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
    }
    .modal-h2 {
      font-size: 1.5rem;
      font-weight: 600;
      letter-spacing: -0.01em;
      color: var(--foreground);
    }
    @media (min-width: 640px) {
      .modal-h2 { font-size: 1.875rem; }
    }

    .modal-form {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .modal-field {
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
    }
    .modal-field-caption {
      font-size: 0.75rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.025em;
      color: rgba(17, 17, 17, 0.5);
    }
    .modal-control {
      width: 100%;
      border: 1px solid var(--line);
      background: rgba(241, 240, 238, 0.5);
      border-radius: var(--radius-control);
      padding: 0.75rem 1rem;
      font-size: 0.875rem;
      font-family: inherit;
      color: var(--foreground);
      outline: none;
      transition: border-color 0.2s ease, background 0.2s ease;
    }
    .modal-control:focus {
      border-color: rgba(17, 17, 17, 0.3);
      background: #fff;
    }
    textarea.modal-control {
      resize: none;
    }

    .modal-bottom-row {
      margin-top: 0.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }
    .modal-reply-note {
      font-size: 0.75rem;
      color: rgba(17, 17, 17, 0.45);
    }

    .modal-success-state {
      display: none;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding-block: 2rem;
      gap: 1rem;
    }
    .modal-success-badge {
      width: 3.5rem;
      height: 3.5rem;
      display: grid;
      place-items: center;
      border-radius: 9999px;
      background: var(--ink);
      color: var(--accent-from);
      font-size: 1.5rem;
    }
    .modal-success-h2 {
      font-size: 1.5rem;
      font-weight: 600;
      color: #111;
    }
    .modal-success-p {
      max-width: 32ch;
      font-size: 0.875rem;
      color: rgba(17, 17, 17, 0.6);
      line-height: 1.45;
    }
  </style>
</head>
<body>

  <!-- Skip link (first focusable) -->
  <a href="#main" class="skip-link">Skip to content</a>

  <!-- ========================================================================
       PAGE LOADER (000 -> 100)
       ======================================================================== -->
  <div id="page-loader" aria-label="Loading site">
    <div class="loader-center" id="loader-center">
      <div class="loader-brand">
        <!-- LogoMark -->
        <svg viewBox="0 0 48 48" fill="currentColor" width="1em" height="1em" aria-hidden="true">
          <path d="M24 2c2.2 13.8 7.9 19.6 22 22-14.1 2.4-19.8 8.2-22 22-2.2-13.8-7.9-19.6-22-22 14.1-2.4 19.8-8.2 22-22Z"/>
        </svg>
        <span>Lumora</span>
      </div>
      <p class="loader-subtext">Bold ideas, shipped with quiet precision.</p>
    </div>
    <div class="loader-progress-wrap">
      <div class="loader-track">
        <div class="loader-fill" id="loader-fill"></div>
      </div>
      <div class="loader-meta">
        <span>Loading</span>
        <span class="loader-counter" id="loader-count">000</span>
      </div>
    </div>
  </div>

  <!-- ========================================================================
       SITE HEADER (Fixed Overlay)
       ======================================================================== -->
  <header id="site-header" role="banner">
    <div class="shell header-inner">
      <!-- Left Brand Button -->
      <button type="button" class="header-logo-btn" id="header-logo-btn" aria-label="Lumora Home">
        <span class="header-logo-span">
          <svg viewBox="0 0 48 48" fill="currentColor" width="1em" height="1em" aria-hidden="true">
            <path d="M24 2c2.2 13.8 7.9 19.6 22 22-14.1 2.4-19.8 8.2-22 22-2.2-13.8-7.9-19.6-22-22 14.1-2.4 19.8-8.2 22-22Z"/>
          </svg>
          Lumora
        </span>
      </button>

      <!-- Center Primary Nav (Desktop lg) -->
      <nav class="primary-nav" aria-label="Main Navigation">
        <ul class="primary-nav-list">
          <li>
            <button type="button" class="nav-btn" data-scroll="home" aria-current="page">
              <span class="nav-btn-label">Home</span>
            </button>
          </li>
          <li>
            <button type="button" class="nav-btn" data-scroll="works">
              <span class="nav-btn-label">Work</span>
            </button>
          </li>
          <li>
            <button type="button" class="nav-btn" data-scroll="services">
              <span class="nav-btn-label">Services <span class="nav-caret">▾</span></span>
            </button>
          </li>
          <li>
            <button type="button" class="nav-btn" data-scroll="about">
              <span class="nav-btn-label">Studio</span>
            </button>
          </li>
          <li>
            <button type="button" class="nav-btn" data-scroll="careers">
              <span class="nav-btn-label">Careers</span>
            </button>
          </li>
          <li>
            <button type="button" class="nav-btn" data-open-modal>
              <span class="nav-btn-label">Contact</span>
            </button>
          </li>
        </ul>
      </nav>

      <!-- Right: Clock chip + Menu button -->
      <div class="header-right">
        <div class="clock-chip" aria-label="Live local clock">
          <span class="clock-label">Local time</span>
          <span class="clock-time live-clock-time">9:41am</span>
          <span class="clock-sep">•</span>
          <span class="clock-date live-clock-date">12 March, 2025</span>
        </div>
        <button type="button" class="menu-btn" id="open-menu-btn" aria-label="Open menu">
          <span class="menu-btn-inner">
            <!-- Grid/menu icon -->
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="1em" height="1em" aria-hidden="true">
              <path d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
            <span class="menu-text">Menu</span>
          </span>
        </button>
      </div>
    </div>
  </header>

  <!-- ========================================================================
       MAIN CONTENT
       ======================================================================== -->
  <main id="main">

    <!-- 1) HERO SECTION (#home) -->
    <section id="home" aria-label="Hero">
      <!-- Full-bleed background with cursor brush reveal -->
      <div class="liquid-reveal-wrap" id="hero-reveal-container">
        <!-- Base LCP image (always shown, beforeSrc = .../hero/after.jpg) -->
        <img
          class="liquid-base-img"
          src="https://api.getlayers.ai/storage/v1/object/public/public/assets/lumora-e8b711fc68/hero/after.jpg"
          alt="Lumora design environment showcase"
          loading="eager"
          fetchpriority="high"
        />
        <!-- Trail canvas paints afterSrc = .../hero/before.jpg -->
        <canvas class="liquid-canvas" id="liquid-canvas" aria-hidden="true"></canvas>
      </div>

      <!-- Legibility vignette -->
      <div class="hero-vignette" aria-hidden="true"></div>

      <!-- Brand watermark -->
      <div class="hero-watermark" id="hero-watermark" aria-hidden="true">LUMORA</div>

      <!-- Content grid -->
      <div class="shell hero-content">
        <!-- Left column -->
        <div class="hero-left">
          <!-- Eyebrow -->
          <div class="spring-reveal" id="hero-eyebrow" style="--reveal-y: 10px;">
            <div class="eyebrow tone-dark">
              <span class="eyebrow-dot"></span>
              <span>Independent Studio</span>
            </div>
          </div>

          <!-- H1 Line Reveal -->
          <h1 class="hero-h1" id="hero-heading">
            <span class="reveal-line-wrap"><span class="reveal-line-inner">Bold ideas,</span></span>
            <span class="reveal-line-wrap"><span class="reveal-line-inner">shipped with</span></span>
            <span class="reveal-line-wrap"><span class="reveal-line-inner">quiet precision</span></span>
          </h1>

          <!-- Rating row -->
          <div class="spring-reveal hero-rating-row" id="hero-rating" style="--reveal-y: 14px;">
            <span class="stars-wrap" aria-label="5 stars rating">
              <!-- 5 Stars -->
              <svg viewBox="0 0 24 24" fill="currentColor" width="1em" height="1em"><path d="M12 2.5l2.9 5.88 6.49.94-4.7 4.58 1.11 6.46L12 17.9l-5.8 3.05 1.1-6.46-4.69-4.58 6.49-.94L12 2.5z"/></svg>
              <svg viewBox="0 0 24 24" fill="currentColor" width="1em" height="1em"><path d="M12 2.5l2.9 5.88 6.49.94-4.7 4.58 1.11 6.46L12 17.9l-5.8 3.05 1.1-6.46-4.69-4.58 6.49-.94L12 2.5z"/></svg>
              <svg viewBox="0 0 24 24" fill="currentColor" width="1em" height="1em"><path d="M12 2.5l2.9 5.88 6.49.94-4.7 4.58 1.11 6.46L12 17.9l-5.8 3.05 1.1-6.46-4.69-4.58 6.49-.94L12 2.5z"/></svg>
              <svg viewBox="0 0 24 24" fill="currentColor" width="1em" height="1em"><path d="M12 2.5l2.9 5.88 6.49.94-4.7 4.58 1.11 6.46L12 17.9l-5.8 3.05 1.1-6.46-4.69-4.58 6.49-.94L12 2.5z"/></svg>
              <svg viewBox="0 0 24 24" fill="currentColor" width="1em" height="1em"><path d="M12 2.5l2.9 5.88 6.49.94-4.7 4.58 1.11 6.46L12 17.9l-5.8 3.05 1.1-6.46-4.69-4.58 6.49-.94L12 2.5z"/></svg>
            </span>
            <span class="rating-text">200+ brands shipped</span>
          </div>

          <!-- CTAs -->
          <div class="spring-reveal hero-cta-row" id="hero-ctas" style="--reveal-y: 14px;">
            <button type="button" class="pill-btn variant-dark has-arrow" data-open-modal>
              <span class="pill-btn-inner">
                <span>Let's Talk</span>
                <span class="pill-btn-badge">
                  <svg class="arrow-right-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="1em" height="1em">
                    <path d="M5 12h14M13 6l6 6-6 6"/>
                  </svg>
                </span>
              </span>
            </button>
            <button type="button" class="pill-btn variant-outline no-arrow" data-scroll="works">
              <span class="pill-btn-inner">
                <span>View Work</span>
              </span>
            </button>
          </div>
        </div>

        <!-- Right column -->
        <div class="hero-right">
          <!-- HeroCard Carousel -->
          <div class="spring-reveal hero-card" id="hero-card" style="--reveal-y: 16px; --reveal-scale-from: 0.96;">
            <div class="hero-card-inner" id="hero-carousel-card">
              <div class="hero-card-tile">
                <svg viewBox="0 0 48 48" fill="currentColor" width="1em" height="1em" aria-hidden="true">
                  <path d="M24 2c2.2 13.8 7.9 19.6 22 22-14.1 2.4-19.8 8.2-22 22-2.2-13.8-7.9-19.6-22-22 14.1-2.4 19.8-8.2 22-22Z"/>
                </svg>
              </div>
              <div class="hero-card-panel">
                <div class="hero-card-slot" id="carousel-slot">
                  <!-- Slide 0 -->
                  <div class="hero-card-slide slide-active" data-slide-index="0">
                    <span class="hero-card-caption">Conversion design</span>
                    <h4 class="hero-card-title">Crafted to convert.</h4>
                  </div>
                  <!-- Slide 1 -->
                  <div class="hero-card-slide slide-in-next" data-slide-index="1">
                    <span class="hero-card-caption">Engineering</span>
                    <h4 class="hero-card-title">Built to scale.</h4>
                  </div>
                  <!-- Slide 2 -->
                  <div class="hero-card-slide slide-in-next" data-slide-index="2">
                    <span class="hero-card-caption">Brand systems</span>
                    <h4 class="hero-card-title">Designed to last.</h4>
                  </div>
                </div>

                <div class="hero-card-controls">
                  <div class="hero-card-dots" id="carousel-dots">
                    <span class="hero-card-dot active" data-dot-index="0"></span>
                    <span class="hero-card-dot inactive" data-dot-index="1"></span>
                    <span class="hero-card-dot inactive" data-dot-index="2"></span>
                  </div>
                  <div class="hero-card-nav-btns">
                    <button type="button" class="hero-card-nav-btn prev" id="carousel-prev-btn" aria-label="Previous slide">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="1em" height="1em">
                        <path d="M5 12h14M13 6l6 6-6 6"/>
                      </svg>
                    </button>
                    <button type="button" class="hero-card-nav-btn next" id="carousel-next-btn" aria-label="Next slide">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="1em" height="1em">
                        <path d="M5 12h14M13 6l6 6-6 6"/>
                      </svg>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Partners -->
          <div class="spring-reveal hero-partners" id="hero-partners" style="--reveal-y: 14px;">
            <p class="partners-label">Trusted by</p>
            <div class="partners-grid" id="partners">
              <span class="partner-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" width="1em" height="1em"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.2" fill="currentColor"/></svg>
                Kaido
              </span>
              <span class="partner-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" width="1em" height="1em"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.2" fill="currentColor"/></svg>
                Northpeak
              </span>
              <span class="partner-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" width="1em" height="1em"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.2" fill="currentColor"/></svg>
                Vellum
              </span>
              <span class="partner-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" width="1em" height="1em"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.2" fill="currentColor"/></svg>
                Orbit
              </span>
              <span class="partner-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" width="1em" height="1em"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.2" fill="currentColor"/></svg>
                Brightline
              </span>
              <span class="partner-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" width="1em" height="1em"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.2" fill="currentColor"/></svg>
                Cobalt
              </span>
              <span class="partner-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" width="1em" height="1em"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.2" fill="currentColor"/></svg>
                Mesa
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom status bar -->
      <div class="shell hero-status-bar spring-reveal" id="hero-status-bar" style="--reveal-y: 0px;">
        <span>Working since 2014</span>
        <span class="status-mid">Remote-first, worldwide</span>
        <span class="status-right" data-scroll="about">Scroll to explore &darr;</span>
      </div>
    </section>

    <!-- 2) ABOUT SECTION (#about) -->
    <section id="about" aria-label="About Lumora">
      <div class="shell about-shell">
        <!-- Left: Globe Block -->
        <div class="about-globe-block">
          <!-- Big SVG Globe watermark -->
          <svg class="about-globe-bg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" width="1em" height="1em" aria-hidden="true">
            <circle cx="12" cy="12" r="9.25"/>
            <path d="M12 2.75c2.6 2.3 4 5.8 4 9.25s-1.4 6.95-4 9.25c-2.6-2.3-4-5.8-4-9.25s1.4-6.95 4-9.25zM2.75 12h18.5"/>
          </svg>

          <div class="about-eyebrow-wrap">
            <div class="eyebrow tone-dark">
              <span class="eyebrow-dot"></span>
              <span>The Studio</span>
            </div>
          </div>

          <div class="about-globe-sub spring-reveal" data-reveal style="--reveal-y: 12px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" width="1em" height="1em">
              <circle cx="12" cy="12" r="9.25"/>
              <path d="M12 2.75c2.6 2.3 4 5.8 4 9.25s-1.4 6.95-4 9.25c-2.6-2.3-4-5.8-4-9.25s1.4-6.95 4-9.25zM2.75 12h18.5"/>
            </svg>
            <span>A distributed team building across every time zone.</span>
          </div>
        </div>

        <!-- Right: Statement -->
        <div class="about-statement" id="careers">
          <!-- H2 Word Reveal -->
          <h2 class="about-h2" id="about-statement-text" data-word-reveal>
            We partner with ambitious teams to ship
            <span class="about-h2-dim">digital products, brand systems, and the strategy that holds them together.</span>
          </h2>

          <div class="about-footer-row spring-reveal" data-reveal style="--reveal-y: 12px; transition-delay: 200ms;">
            <div class="social-block">
              <span class="social-label">Find us online</span>
              <div class="social-chips-row">
                <!-- X / Twitter -->
                <a href="#twitter" class="social-chip chip-accent" aria-label="X / Twitter">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="1em" height="1em">
                    <path d="M4 4l16 16M20 4 4 20"/>
                  </svg>
                </a>
                <!-- Behance -->
