  <!-- ========================================================================
       REQUEST MODAL (Stubbed Submit)
       ======================================================================== -->
  <div id="request-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="modal-panel" id="modal-panel">
      <!-- Close button -->
      <button type="button" class="modal-close-btn" id="modal-close-btn" aria-label="Close modal">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="1em" height="1em">
          <path d="M4 4l16 16M20 4 4 20"/>
        </svg>
      </button>

      <!-- Form View -->
      <div id="modal-form-view">
        <div class="modal-header-block">
          <div class="eyebrow tone-dark">
            <span class="eyebrow-dot" style="background:#b15f2c;"></span>
            <span>Start a project</span>
          </div>
          <h2 class="modal-h2" id="modal-title">Tell us what you're building.</h2>
        </div>

        <form class="modal-form" id="project-request-form">
          <div class="modal-field">
            <label for="req-name" class="modal-field-caption">Name</label>
            <input type="text" id="req-name" class="modal-control" placeholder="Your name" required />
          </div>

          <div class="modal-field">
            <label for="req-email" class="modal-field-caption">Email</label>
            <input type="email" id="req-email" class="modal-control" placeholder="you@company.com" required />
          </div>

          <div class="modal-field">
            <label for="req-project" class="modal-field-caption">Project</label>
            <textarea id="req-project" class="modal-control" rows="4" placeholder="A few words about your project, timeline, and budget." required></textarea>
          </div>

          <div class="modal-bottom-row">
            <span class="modal-reply-note">We reply within one business day.</span>
            <button type="submit" class="pill-btn variant-dark has-arrow" id="form-submit-btn">
              <span class="pill-btn-inner">
                <span id="submit-btn-text">Send request</span>
                <span class="pill-btn-badge">
                  <svg class="arrow-up-right-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="1em" height="1em">
                    <path d="M7 17 17 7M8 7h9v9"/>
                  </svg>
                </span>
              </span>
            </button>
          </div>
        </form>
      </div>

      <!-- Success View -->
      <div class="modal-success-state" id="modal-success-view">
        <div class="modal-success-badge">
          <svg viewBox="0 0 48 48" fill="currentColor" width="1.5rem" height="1.5rem" aria-hidden="true">
            <path d="M24 2c2.2 13.8 7.9 19.6 22 22-14.1 2.4-19.8 8.2-22 22-2.2-13.8-7.9-19.6-22-22 14.1-2.4 19.8-8.2 22-22Z"/>
          </svg>
        </div>
        <h2 class="modal-success-h2">Request received</h2>
        <p class="modal-success-p">Thanks for reaching out — we'll get back to you within one business day.</p>
        <button type="button" class="pill-btn variant-dark no-arrow" id="modal-success-close-btn" style="margin-top:0.5rem;">
          <span class="pill-btn-inner">Close</span>
        </button>
      </div>
    </div>
  </div>

  <!-- ========================================================================
       SCRIPTS (Lenis Importmap + Single ES Module)
       ======================================================================== -->
  <script type="importmap">
  {
    "imports": {
      "lenis": "https://unpkg.com/lenis@1.3.23/dist/lenis.mjs"
    }
  }
  </script>

  <script type="module">
    import Lenis from 'lenis';

    // 1. Reset scroll to top
    window.scrollTo(0, 0);

    // 2. Initialize Lenis smooth-scroll
    const lenis = new Lenis({ smoothWheel: true });
    function raf(t) {
      lenis.raf(t);
      requestAnimationFrame(raf);
    }
    requestAnimationFrame(raf);

    // 3. Scroll lock model
    let scrollEnabled = true;
    function stopScroll() {
      scrollEnabled = false;
      lenis.stop();
      document.documentElement.style.position = 'relative';
      document.documentElement.style.overflow = 'hidden';
      document.documentElement.style.height = '100%';
    }
    function startScroll() {
      scrollEnabled = true;
      lenis.start();
      document.documentElement.style.removeProperty('position');
      document.documentElement.style.removeProperty('overflow');
      document.documentElement.style.removeProperty('height');
    }

    // 4. Smooth scrollTo(id) helper per spec:
    // Temporarily disable scroll-state, then after 50ms smooth scroll, re-enable after 100ms
    function scrollToId(id) {
      const el = document.getElementById(id);
      if (!el) return;
      stopScroll();
      setTimeout(() => {
        const top = el.getBoundingClientRect().top + window.pageYOffset;
        window.scrollTo({ top, behavior: 'smooth' });
        setTimeout(() => {
          startScroll();
        }, 100);
      }, 50);
    }

    // 5. Adaptive Grid Scale-Up above 1920px
    function applyAdaptiveGrid() {
      const FONT_BASE = 16, baseWidth = 1920, coef = 0.6666;
      const w = window.innerWidth;
      const widthReduction = ((baseWidth - w) / baseWidth) * 100;
      const size = FONT_BASE - (FONT_BASE * (widthReduction * coef)) / 100;
      if (size > FONT_BASE) {
        document.documentElement.style.fontSize = size + 'px';
      } else {
        document.documentElement.style.removeProperty('font-size');
      }
    }
    applyAdaptiveGrid();
    window.addEventListener('resize', applyAdaptiveGrid);

    // 6. Global Ready Flag & Reveals Coordinator
    let introReady = false;

    function triggerReadyReveals() {
      introReady = true;

      // Header entrance (delay 150ms after ready)
      setTimeout(() => {
        const header = document.getElementById('site-header');
        if (header) header.classList.add('is-revealed');
      }, 150);

      // Hero Eyebrow (delay 200ms)
      setTimeout(() => {
        const eyebrow = document.getElementById('hero-eyebrow');
        if (eyebrow) eyebrow.classList.add('is-revealed');
      }, 200);

      // Hero H1 (delay 250ms, lineStagger 120ms)
      setTimeout(() => {
        const lines = document.querySelectorAll('#hero-heading .reveal-line-inner');
        lines.forEach((line, idx) => {
          setTimeout(() => {
            line.classList.add('revealed');
          }, idx * 120);
        });
      }, 250);

      // Brand Watermark (delay 300ms)
      setTimeout(() => {
        const watermark = document.getElementById('hero-watermark');
        if (watermark) watermark.classList.add('is-revealed');
      }, 300);

      // Hero Carousel Card (delay 400ms)
      setTimeout(() => {
        const card = document.getElementById('hero-card');
        if (card) card.classList.add('is-revealed');
      }, 400);

      // Hero Partners (delay 550ms)
      setTimeout(() => {
        const partners = document.getElementById('hero-partners');
        if (partners) partners.classList.add('is-revealed');
      }, 550);

      // Rating Row (delay 650ms)
      setTimeout(() => {
        const rating = document.getElementById('hero-rating');
        if (rating) rating.classList.add('is-revealed');
      }, 650);

      // CTAs (delay 750ms)
      setTimeout(() => {
        const ctas = document.getElementById('hero-ctas');
        if (ctas) ctas.classList.add('is-revealed');
      }, 750);

      // Status Bar (delay 900ms)
      setTimeout(() => {
        const status = document.getElementById('hero-status-bar');
        if (status) status.classList.add('is-revealed');
      }, 900);
    }

    // 7. PageLoader Animation
    const pageLoader = document.getElementById('page-loader');
    const loaderFill = document.getElementById('loader-fill');
    const loaderCount = document.getElementById('loader-count');
    const loaderCenter = document.getElementById('loader-center');

    stopScroll();

    const FILL_MS = 1300;
    const loaderStartTime = performance.now();

    function easeInOutCubic(t) {
      return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    }

    function stepLoader(now) {
      const elapsed = now - loaderStartTime;
      const t = Math.min(elapsed / FILL_MS, 1);
      const progress = Math.round(easeInOutCubic(t) * 100);

      if (loaderFill) loaderFill.style.width = progress + '%';
      if (loaderCount) loaderCount.textContent = String(progress).padStart(3, '0');

      if (t < 1) {
        requestAnimationFrame(stepLoader);
      } else {
        // Exit animation: center content fades/translates up, panel slides up
        if (loaderCenter) {
          loaderCenter.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
          loaderCenter.style.opacity = '0';
          loaderCenter.style.transform = 'translateY(-12px)';
        }

        if (pageLoader) {
          pageLoader.style.transition = 'transform 0.7s cubic-bezier(0.22, 1, 0.36, 1)';
          pageLoader.style.transform = 'translateY(-100%)';
        }

        setTimeout(() => {
          if (pageLoader && pageLoader.parentNode) {
            pageLoader.parentNode.removeChild(pageLoader);
          }
          startScroll();
          triggerReadyReveals();
        }, 700);
      }
    }
    requestAnimationFrame(stepLoader);

    // 8. Live Clock (updates every 1s)
    const timeEls = document.querySelectorAll('.live-clock-time');
    const dateEls = document.querySelectorAll('.live-clock-date');

    const MONTHS = [
      'January', 'February', 'March', 'April', 'May', 'June',
      'July', 'August', 'September', 'October', 'November', 'December'
    ];

    function updateLiveClock() {
      const now = new Date();
      let hours = now.getHours();
      const minutes = String(now.getMinutes()).padStart(2, '0');
      const meridiem = hours >= 12 ? 'pm' : 'am';
      hours = hours % 12 || 12;

      const timeStr = `${hours}:${minutes}${meridiem}`;
      const dateStr = `${now.getDate()} ${MONTHS[now.getMonth()]}, ${now.getFullYear()}`;

      timeEls.forEach(el => el.textContent = timeStr);
      dateEls.forEach(el => el.textContent = dateStr);
    }
    updateLiveClock();
    setInterval(updateLiveClock, 1000);

    // 9. Signature Hero LiquidReveal Effect
    (function initLiquidReveal() {
      const container = document.getElementById('hero-reveal-container');
      const canvas = document.getElementById('liquid-canvas');
      if (!container || !canvas) return;

      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReduced) return;

      const ctx = canvas.getContext('2d');
      const brushRadius = 143;
      const decay = 0.016;
      let dpr = Math.min(window.devicePixelRatio || 1, 2);

      let width = 0;
      let height = 0;
      let coverCanvas = document.createElement('canvas');
      let coverCtx = coverCanvas.getContext('2d');

      let brushCanvas = document.createElement('canvas');
      let brushCtx = brushCanvas.getContext('2d');
      let radius = brushRadius * dpr;
      let diam = Math.ceil(radius * 2);

      // Note: mapping preserved exactly:
      // beforeSrc (base image) = .../hero/after.jpg (set on <img>)
      // afterSrc (trail brush image) = .../hero/before.jpg
      const afterImg = new Image();
      afterImg.crossOrigin = 'anonymous';
      afterImg.src = 'https://api.getlayers.ai/storage/v1/object/public/public/assets/lumora-e8b711fc68/hero/before.jpg';

      function updateSizes() {
        const rect = container.getBoundingClientRect();
        if (rect.width === 0 || rect.height === 0) return;
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        width = Math.ceil(rect.width * dpr);
        height = Math.ceil(rect.height * dpr);

        canvas.width = width;
        canvas.height = height;

        coverCanvas.width = width;
        coverCanvas.height = height;

        radius = brushRadius * dpr;
        diam = Math.ceil(radius * 2);
        brushCanvas.width = diam;
        brushCanvas.height = diam;

        if (afterImg.complete && afterImg.naturalWidth) {
          renderCover();
        }
      }

      function renderCover() {
        if (!width || !height || !afterImg.naturalWidth) return;
        const scale = Math.max(width / afterImg.naturalWidth, height / afterImg.naturalHeight);
        const dw = afterImg.naturalWidth * scale;
        const dh = afterImg.naturalHeight * scale;
        const dx = (width - dw) / 2;
        const dy = (height - dh) / 2;
        coverCtx.clearRect(0, 0, width, height);
        coverCtx.drawImage(afterImg, dx, dy, dw, dh);
      }

      afterImg.onload = renderCover;

      const ro = new ResizeObserver(() => {
        updateSizes();
      });
      ro.observe(container);
      updateSizes();

      // Brush stamp helper
      function stamp(x, y) {
        const c = diam / 2;
        brushCtx.clearRect(0, 0, diam, diam);
        brushCtx.globalCompositeOperation = 'source-over';

        const grad = brushCtx.createRadialGradient(c, c, 0, c, c, radius);
        grad.addColorStop(0, 'rgba(255, 255, 255, 1)');
        grad.addColorStop(0.55, 'rgba(255, 255, 255, 0.82)');
        grad.addColorStop(1, 'rgba(255, 255, 255, 0)');

        brushCtx.fillStyle = grad;
        brushCtx.fillRect(0, 0, diam, diam);

        brushCtx.globalCompositeOperation = 'source-in';
        try {
          brushCtx.drawImage(coverCanvas, -(x - c), -(y - c));
        } catch (e) {}

        ctx.globalCompositeOperation = 'source-over';
        ctx.drawImage(brushCanvas, x - c, y - c);
      }

      // Pointer tracking & interpolation
      const points = [];
      let lastPoint = null;
      let idle = 0;

      window.addEventListener('pointermove', (e) => {
        const rect = container.getBoundingClientRect();
        const x = (e.clientX - rect.left) * dpr;
        const y = (e.clientY - rect.top) * dpr;

        if (x < -radius || x > width + radius || y < -radius || y > height + radius) {
          lastPoint = null;
          return;
        }

        if (lastPoint) {
          const dx = x - lastPoint.x;
          const dy = y - lastPoint.y;
          const dist = Math.hypot(dx, dy);
          const step = Math.max(radius * 0.3, 1);
          const n = Math.min(Math.ceil(dist / step), 60);
          for (let i = 1; i <= n; i++) {
            points.push({
              x: lastPoint.x + dx * (i / n),
              y: lastPoint.y + dy * (i / n)
            });
          }
        } else {
          points.push({ x, y });
        }
        lastPoint = { x, y };
      });

      // Render tick loop
      function liquidTick() {
        const drawing = points.length > 0;
        if (drawing) {
          idle = 0;
        } else {
          idle++;
        }

        if (idle <= 120) {
          const fade = drawing ? decay : Math.min(decay + idle * 0.004, 0.5);
          ctx.globalCompositeOperation = 'destination-out';
          ctx.fillStyle = `rgba(0, 0, 0, ${fade})`;
          ctx.fillRect(0, 0, width, height);

          if (drawing) {
            for (let i = 0; i < points.length; i++) {
              stamp(points[i].x, points[i].y);
            }
            points.length = 0;
          }

          if (idle === 120) {
            ctx.clearRect(0, 0, width, height);
          }
        }

        requestAnimationFrame(liquidTick);
      }
      requestAnimationFrame(liquidTick);
    })();

    // 10. HeroCard Carousel Logic
    (function initHeroCardCarousel() {
      const slides = document.querySelectorAll('.hero-card-slide');
      const dots = document.querySelectorAll('.hero-card-dot');
      const prevBtn = document.getElementById('carousel-prev-btn');
      const nextBtn = document.getElementById('carousel-next-btn');
      const card = document.getElementById('hero-carousel-card');

      if (!slides.length) return;

      let currentIdx = 0;
      const count = slides.length;

      function goToSlide(newIdx, direction = 'next') {
        if (newIdx === currentIdx) return;
        const oldSlide = slides[currentIdx];
        const newSlide = slides[newIdx];

        // Class swaps
        oldSlide.className = `hero-card-slide ${direction === 'next' ? 'slide-out-next' : 'slide-out-prev'}`;
        newSlide.className = `hero-card-slide ${direction === 'next' ? 'slide-in-next' : 'slide-in-prev'}`;

        // Force reflow
        void newSlide.offsetWidth;

        newSlide.className = 'hero-card-slide slide-active';

        // Dots update
        dots.forEach((dot, idx) => {
          if (idx === newIdx) {
            dot.className = 'hero-card-dot active';
          } else {
            dot.className = 'hero-card-dot inactive';
          }
        });

        currentIdx = newIdx;
      }

      function nextSlide() {
        goToSlide((currentIdx + 1) % count, 'next');
      }

      function prevSlide() {
        goToSlide((currentIdx - 1 + count) % count, 'prev');
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          nextSlide();
        });
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          prevSlide();
        });
      }

      if (card) {
        card.addEventListener('click', () => {
          nextSlide();
        });
      }
    })();

    // 11. Word Reveal & Line Reveal via IntersectionObserver
    (function initTextReveals() {
      // Split [data-word-reveal] into animated words while preserving inner spans
      const wordRevealEls = document.querySelectorAll('[data-word-reveal]');
      wordRevealEls.forEach(el => {
        function processNode(node) {
          if (node.nodeType === Node.TEXT_NODE) {
            const text = node.textContent;
            const words = text.split(/(\s+)/);
            const fragment = document.createDocumentFragment();
            words.forEach(word => {
              if (word.trim().length > 0) {
                const span = document.createElement('span');
                span.className = 'word-reveal-word';
                span.textContent = word;
                fragment.appendChild(span);
              } else if (word.length > 0) {
                fragment.appendChild(document.createTextNode(word));
              }
            });
            node.parentNode.replaceChild(fragment, node);
          } else if (node.nodeType === Node.ELEMENT_NODE) {
            Array.from(node.childNodes).forEach(processNode);
          }
        }
        Array.from(el.childNodes).forEach(processNode);
      });

      // Observer for scroll triggers
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const target = entry.target;
            target.classList.add('is-revealed');

            // Line reveals inside
            const lines = target.querySelectorAll('.reveal-line-inner');
            lines.forEach((line, idx) => {
              setTimeout(() => {
                line.classList.add('revealed');
              }, idx * 100);
            });

            // Word reveals inside
            const words = target.querySelectorAll('.word-reveal-word');
            words.forEach((word, idx) => {
              setTimeout(() => {
                word.classList.add('revealed');
              }, idx * 35);
            });

            observer.unobserve(target);
          }
        });
      }, {
        threshold: 0.15,
        rootMargin: '0px 0px -50px 0px'
      });

      document.querySelectorAll('[data-reveal], [data-line-reveal], [data-word-reveal]').forEach(el => {
        observer.observe(el);
      });
    })();

    // 12. Stats Scroll Count-up Trigger
    (function initStatsCountUp() {
      const statsGrid = document.getElementById('stats-grid');
      const numberEls = document.querySelectorAll('.stat-number');
      if (!statsGrid || !numberEls.length) return;

      let hasTriggered = false;
      let lastScroll = 0;

      function checkStatsProgress() {
        if (hasTriggered) return;
        const now = performance.now();
        if (now - lastScroll < 30) return;
        lastScroll = now;

        const rect = statsGrid.getBoundingClientRect();
        const vh = window.innerHeight;

        // start: "top bottom" (rect.top <= vh)
        // end: "center center" (rect.top + rect.height / 2 <= vh / 2)
        const totalDistance = vh * 0.5 + rect.height * 0.5;
        const distanceCovered = vh - rect.top;
        const progress = Math.max(0, Math.min(1, distanceCovered / totalDistance));

        numberEls.forEach(el => {
          const target = parseFloat(el.getAttribute('data-target')) || 0;
          const currentVal = Math.round(progress * target);
          el.textContent = currentVal;
        });

        if (progress >= 1) {
          hasTriggered = true;
          window.removeEventListener('scroll', checkStatsProgress);
        }
      }

      window.addEventListener('scroll', checkStatsProgress, { passive: true });
      checkStatsProgress();
    })();

    // 13. NavMenu Overlay Controls
    const navMenu = document.getElementById('nav-menu');
    const openMenuBtn = document.getElementById('open-menu-btn');
    const closeMenuBtn = document.getElementById('close-menu-btn');
    const navMenuCtaBtn = document.getElementById('nav-menu-start-cta');

    function openNavMenu() {
      if (!navMenu) return;
      navMenu.classList.add('is-open');
      stopScroll();
    }

    function closeNavMenu() {
      if (!navMenu) return;
      navMenu.classList.remove('is-open');
      startScroll();
    }

    if (openMenuBtn) openMenuBtn.addEventListener('click', openNavMenu);
    if (closeMenuBtn) closeMenuBtn.addEventListener('click', closeNavMenu);

    document.querySelectorAll('[data-menu-target]').forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-menu-target');
        closeNavMenu();
        setTimeout(() => {
          scrollToId(targetId);
        }, 150);
      });
    });

    document.querySelectorAll('[data-menu-contact]').forEach(btn => {
      btn.addEventListener('click', () => {
        closeNavMenu();
        setTimeout(() => {
          openRequestModal();
        }, 150);
      });
    });

    if (navMenuCtaBtn) {
      navMenuCtaBtn.addEventListener('click', () => {
        closeNavMenu();
        setTimeout(() => {
          openRequestModal();
        }, 150);
      });
    }

    // 14. RequestModal Controls & Stub Submit
    const requestModal = document.getElementById('request-modal');
    const modalPanel = document.getElementById('modal-panel');
    const modalCloseBtn = document.getElementById('modal-close-btn');
    const formView = document.getElementById('modal-form-view');
    const successView = document.getElementById('modal-success-view');
    const projectForm = document.getElementById('project-request-form');
    const submitBtn = document.getElementById('form-submit-btn');
    const submitBtnText = document.getElementById('submit-btn-text');
    const successCloseBtn = document.getElementById('modal-success-close-btn');

    function openRequestModal() {
      if (!requestModal) return;
      requestModal.classList.add('is-open');
      stopScroll();
    }

    function closeRequestModal() {
      if (!requestModal) return;
      requestModal.classList.remove('is-open');
      startScroll();

      // Reset form after exit animation completes
      setTimeout(() => {
        if (projectForm) projectForm.reset();
        if (formView) formView.style.display = 'block';
        if (successView) successView.style.display = 'none';
        if (submitBtnText) submitBtnText.textContent = 'Send request';
        if (submitBtn) submitBtn.disabled = false;
      }, 350);
    }

    document.querySelectorAll('[data-open-modal]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        openRequestModal();
      });
    });

    if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeRequestModal);
    if (successCloseBtn) successCloseBtn.addEventListener('click', closeRequestModal);

    // Close on backdrop click (prevent when clicking panel)
    if (requestModal) {
      requestModal.addEventListener('click', (e) => {
        if (e.target === requestModal) {
          closeRequestModal();
        }
      });
    }
    if (modalPanel) {
      modalPanel.addEventListener('click', (e) => {
        e.stopPropagation();
      });
    }

    // ESC key closes overlays
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (requestModal && requestModal.classList.contains('is-open')) {
          closeRequestModal();
        } else if (navMenu && navMenu.classList.contains('is-open')) {
          closeNavMenu();
        }
      }
    });

    // Stub form submit
    if (projectForm) {
      projectForm.addEventListener('submit', (e) => {
        e.preventDefault();
        if (submitBtnText) submitBtnText.textContent = 'Sending…';
        if (submitBtn) submitBtn.disabled = true;

        setTimeout(() => {
          if (formView) formView.style.display = 'none';
          if (successView) successView.style.display = 'flex';
        }, 500);
      });
    }

    // 15. Global Scroll Click Routing
    document.querySelectorAll('[data-scroll]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = btn.getAttribute('data-scroll');
        scrollToId(targetId);
      });
    });

    const headerLogoBtn = document.getElementById('header-logo-btn');
    if (headerLogoBtn) {
      headerLogoBtn.addEventListener('click', () => {
        scrollToId('home');
      });
    }
  </script>
</body>
</html>
